{
    "version": "1.0",
    "mapping": {
        "table_name": "dbo_customer",
        "primary_key": ["customer_id"],
        "precombine_field": "effective_from",
        "write_mode": "upsert"
    },
    "hudi": {
        "table_type": "MERGE_ON_READ",
        "options": {
            "hoodie.upsert.shuffle.parallelism": 2,
            "hoodie.insert.shuffle.parallelism": 2,
            "hoodie.consistency.check.enabled": true,
            "hoodie.parquet.compression.codec": "snappy",
            "hoodie.datasource.write.operation.field": "op",
            "hoodie.datasource.write.operation.field.values.insert": "I",
            "hoodie.datasource.write.operation.field.values.upsert": "U",
            "hoodie.datasource.write.operation.field.values.delete": "D"
        },
        "compaction": {
            "enabled": true,
            "trigger_strategy": "NUM_COMMITS",
            "trigger_max_commits": 5
        }
    },
    "scd": {
        "type": 2,
        "effective_from_field": "effective_from",
        "effective_to_field": "effective_to",
        "is_current_field": "is_current",
        "high_date": "9999-12-31 00:00:00"
    },
    "bookmark": {
        "path": "data/bookmarks/bookmark.json",
        "file_pattern": "cdc_*.csv"
    },
    "columns": [
        {
            "seq": 1,
            "source": "customer_id",
            "target": "customer_id",
            "type": "STRING",
            "nullable": false,
            "rules": []
        },
        {
            "seq": 2,
            "source": "op",
            "target": "op",
            "type": "STRING",
            "nullable": false,
            "rules": [
                { "op": "TRIM" }
            ]
        },
        {
            "seq": 3,
            "source": "first_name",
            "target": "first_name",
            "type": "STRING",
            "nullable": false,
            "rules": [
                { "op": "TRIM" },
                { "op": "UPPER" }
            ]
        },
        {
            "seq": 4,
            "source": "last_name",
            "target": "last_name",
            "type": "STRING",
            "nullable": false,
            "rules": [
                { "op": "TRIM" },
                { "op": "UPPER" }
            ]
        },
        {
            "seq": 5,
            "source": "full_name",
            "target": "customer_full_name",
            "type": "STRING",
            "nullable": true,
            "rules": [
                { "op": "TRIM" }
            ]
        },
        {
            "seq": 6,
            "source": "email_address",
            "target": "email",
            "type": "STRING",
            "nullable": true,
            "rules": [
                { "op": "TRIM" },
                { "op": "LOWER" }
            ]
        },
        {
            "seq": 7,
            "source": "phone_number",
            "target": "phone",
            "type": "STRING",
            "nullable": true,
            "rules": [
                { "op": "REGEX_REPLACE", "pattern": "[^0-9+]", "replacement": "" }
            ]
        },
        {
            "seq": 8,
            "source": "age",
            "target": "age",
            "type": "INT",
            "nullable": true,
            "rules": [
                { "op": "CAST", "on_error": "NULLIFY" }
            ]
        },
        {
            "seq": 9,
            "source": "annual_income",
            "target": "annual_income",
            "type": "DOUBLE",
            "nullable": true,
            "rules": [
                { "op": "CAST", "on_error": "NULLIFY" }
            ]
        },
        {
            "seq": 10,
            "source": "is_active",
            "target": "is_active",
            "type": "BOOLEAN",
            "nullable": false,
            "rules": [
                { "op": "COALESCE", "default": true }
            ]
        },
        {
            "seq": 11,
            "source": "loyalty_tier",
            "target": "loyalty_tier",
            "type": "STRING",
            "nullable": true,
            "rules": [
                { "op": "COALESCE", "default": "STANDARD" },
                { "op": "TRIM" },
                { "op": "UPPER" }
            ]
        },
        {
            "seq": 12,
            "source": "date_of_birth",
            "target": "date_of_birth",
            "type": "DATE",
            "nullable": true,
            "rules": [
                { "op": "CAST", "format": "yyyy-MM-dd", "on_error": "NULLIFY" }
            ]
        },
        {
            "seq": 13,
            "source": "created_at",
            "target": "created_at",
            "type": "TIMESTAMP",
            "nullable": false,
            "rules": [
                { "op": "CAST", "format": "yyyy-MM-dd HH:mm:ss", "on_error": "NULLIFY" }
            ]
        },
        {
            "seq": 14,
            "source": "updated_at",
            "target": "updated_at",
            "type": "TIMESTAMP",
            "nullable": true,
            "rules": [
                { "op": "CAST", "format": "yyyy-MM-dd HH:mm:ss", "on_error": "NULLIFY" }
            ]
        },
        {
            "seq": 15,
            "source": null,
            "target": "effective_from",
            "type": "TIMESTAMP",
            "nullable": false,
            "rules": [
                { "op": "DERIVED", "expr": "COALESCE(updated_at, created_at)" }
            ]
        },
        {
            "seq": 16,
            "source": null,
            "target": "effective_to",
            "type": "TIMESTAMP",
            "nullable": false,
            "rules": [
                { "op": "DERIVED", "expr": "'9999-12-31 00:00:00'" }
            ]
        },
        {
            "seq": 17,
            "source": null,
            "target": "is_current",
            "type": "BOOLEAN",
            "nullable": false,
            "rules": [
                { "op": "DERIVED", "expr": "CASE WHEN op = 'D' THEN false ELSE true END" }
            ]
        },
        {
            "seq": 18,
            "source": null,
            "target": "ingestion_ts",
            "type": "TIMESTAMP",
            "nullable": false,
            "rules": [
                { "op": "DERIVED", "expr": "current_timestamp()" }
            ]
        }
    ]
}